{
    "name": "contenir/contenir-cdn",
    "description": "Framework-free CDN purging for Contenir: the purger interface, cache-tag naming, URL batching, debouncing and a Cloudflare API client that signs in with a token.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "cdn",
        "cache",
        "purge",
        "cloudflare"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-cdn/issues",
        "source": "https://github.com/contenir/contenir-cdn"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Cdn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Cdn\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
